# 首次启动必填（至少 12 个字符、最多 72 字节）；之后可省略。
# 网页修改的密码会持久保存；此值不变时不会覆盖网页密码。
# 将此值改为不同于上次配置的密码并重启，可重置密码并清除旧会话。
ADMIN_PASSWORD=replace-with-at-least-12-characters
NODE_ROLE=primary
LISTEN_ADDR=:8080
DATA_DIR=./data
# 在反向代理后运行时填外部 HTTPS 根地址，用于 Cookie 与来源校验。
APP_ORIGIN=https://mail.example.com
# Docker HTTP 绑定；自动 HTTPS 时保留 loopback，IP 直连时使用 0.0.0.0。
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# 代理模式：npm（现有 Nginx Proxy Manager）、caddy（自动 HTTPS）、direct（HTTP）。
# 一键脚本的新部署默认 npm；已有服务器 .env 的模式会持续保留。
PROXY_MODE=npm
# 网站纯域名；APP_ORIGIN 仍需填写完整的外部 HTTPS 根地址。
MAIL_DOMAIN=
# NPM 与应用位于同一 Docker 主机；填写 NPM 已有的用户自定义 bridge 网络。
# 一键脚本留空时尝试自动识别。
NPM_NETWORK=
NPM_UPSTREAM=mail-lite-app
# 可选：base64url 编码的 32 字节 AES 密钥。留空自动创建 data/data.key。
DATA_KEY=
UPSTREAM_CONCURRENCY=16
# 也可由程序直接终止 TLS；两项必须一起填写。
TLS_CERT=
TLS_KEY=

# 自有域名 MX 收信：仅 primary 可启用，默认关闭。
SMTP_ENABLED=false
SMTP_LISTEN_ADDR=:2525
# 公网收信主机名，例如 mx.example.com；启用时必填。
SMTP_HOSTNAME=
# 可选 STARTTLS 证书；两项必须一起填写，路径需在运行环境内可读。
SMTP_TLS_CERT=
SMTP_TLS_KEY=
